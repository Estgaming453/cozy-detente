{
  "name": "eclipse-rencontres",
  "version": "1.3.0",
  "private": true,
  "description": "Refuge de détente Estgaming en 3D pour Windows et Android",
  "main": "electron/main.cjs",
  "scripts": {
    "build:web": "node scripts/build-web.mjs",
    "build:windows": "npm run build:web && node scripts/build-windows.mjs",
    "build:android": "npm run build:web && node scripts/build-android.mjs"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "fr.eclipse.rencontres",
    "productName": "Estgaming",
    "directories": {
      "output": "dist/windows"
    },
    "files": [
      "electron/**/*",
      "www/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "artifactName": "Estgaming-Setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "portable": {
      "artifactName": "Estgaming-Portable-${version}.${ext}"
    }
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@44.9.0": true
  }
}
